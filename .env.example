# 複製此檔為 .env 並填入你的設定
# cp .env.example .env

# ── Telegram Bot 設定 ────────────────────────────────
# 1. 到 Telegram 找 @BotFather，輸入 /newbot 建立機器人
# 2. 建立完成後會拿到一串 Token，貼到下面
TELEGRAM_BOT_TOKEN=你的_Bot_Token

# 3. 找 @userinfobot 取得你的 Chat ID，貼到下面
#    或：直接在你的 Bot 傳一則訊息後，用瀏覽器開
#    https://api.telegram.org/bot<你的Token>/getUpdates
#    找到 "chat":{"id": 這個數字}
TELEGRAM_CHAT_ID=你的_Chat_ID
